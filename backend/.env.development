# Azure OpenAI Settings (Development/Testing Values)
AZURE_OPENAI_API_KEY=sk-dummy-key-for-development
AZURE_OPENAI_ENDPOINT=https://dummy-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Application Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,https://*.github.dev

# Vector DB Settings
VECTOR_STORE_PATH=./data/vector_store
CHROMA_PERSIST_DIRECTORY=data/chroma

# Document Processing Settings
MAX_DOCUMENT_SIZE_MB=10

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4000

# Database Settings
DATABASE_URL=sqlite:///./data/db/testus.db 