# Azure OpenAI Settings (Development/Testing Values)
AZURE_OPENAI_ENDPOINT=https://dummy-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embeddings Configuration
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=gpt-35-turbo-embeddings
AZURE_OPENAI_EMBEDDINGS_API_KEY=sk-dummy-key-for-development

# Chat Configuration
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-35-turbo
AZURE_OPENAI_CHAT_API_KEY=sk-dummy-key-for-development
AZURE_OPENAI_CHAT_API_VERSION=2024-02-15-preview

# Vector Store Configuration
VECTOR_STORE_DIR=./data/vector_store

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://*.github.dev

# Additional Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4000
MAX_DOCUMENT_SIZE_MB=10
SUPPORTED_DOCUMENT_TYPES=pdf,txt,md,html

# DB Settings
DB_PATH=./data/db/testus.db
DATABASE_URL=sqlite:///./data/db/testus.db 