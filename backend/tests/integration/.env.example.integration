# Database configuration
DATABASE_URL=sqlite+aiosqlite:///./tests/test_data/db/test.db
DB_PATH=./tests/test_data/db/test.db

# Vector store configuration
VECTOR_STORE_DIR=./tests/test_data/vector_store

# Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/

# Deployment embeddings
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_EMBEDDINGS_API_KEY=your-embeddings-api-key
AZURE_OPENAI_API_VERSION=2023-05-15

# Deployment gpt 35
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-35-turbo-16k
AZURE_OPENAI_CHAT_API_KEY=your-chat-api-key
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-app-name.app.github.dev,https://*.app.github.dev

# Additional Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_TOKENS=1000
MAX_DOCUMENT_SIZE_MB=10
SUPPORTED_DOCUMENT_TYPES=pdf,txt,md,html