{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 1
            }
        },
        {
            "name": "Python: Run Integration Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/integration",
                "-v",
                "--junitxml=test-results.xml"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "console": "integratedTerminal",
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 2
            }
        },
        {
            "name": "Python: Run Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--cov=app",
                "--cov-report=term-missing"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "console": "integratedTerminal",
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 2
            }
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "presentation": {
                "hidden": false,
                "group": "Development",
                "order": 1
            }
        },
        {
            "name": "Python: Debug Backend",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Python: Debug Conversation",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app/main.py",
            "args": [
                "--debug-conversation"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Python: Debug Script",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/debug_script.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Node.js: Frontend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "start"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Chrome: Frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*"
            }
        },
        {
            "name": "Python: Debug Integration Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/integration/test_jira_and_vector_api.py",
                "-v",
                "--junitxml=test-results.xml"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/tests/integration/.env.integration",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "purpose": [
                "debug-test"
            ],
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 3
            }
        },
        {
            "name": "Python: Debug Integration Tests RAG Queries",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/integration/test_rag_queries.py",
                "-v",
                "--junitxml=test-results.xml"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/tests/integration/.env.integration",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "purpose": [
                "debug-test"
            ],
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 3
            }
        },
        {
            "name": "Python: Debug Integration Tests Conversation API",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/integration/test_conversation_api.py",
                "-v",
                "--junitxml=test-results.xml"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/tests/integration/.env.integration",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "purpose": [
                "debug-test"
            ],
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 3
            }
        },
        {
            "name": "Python: Debug Integration Tests RAG Quality",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/integration/test_rag_quality.py",
                "-v",
                "--junitxml=test-results.xml"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/tests/integration/.env.integration",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "purpose": [
                "debug-test"
            ],
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 3
            }
        },
        {
            "name": "Python: Dify Jira Connector",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/dify_jira_connector/example.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "python": "${workspaceFolder}/dify_jira_connector/venv/bin/python",
            "presentation": {
                "hidden": false,
                "group": "Development",
                "order": 2
            }
        },
    ],
    "compounds": [
        {
            "name": "Backend: Full Debug",
            "configurations": [
                "Python: FastAPI"
            ],
            "presentation": {
                "hidden": false,
                "group": "Backend",
                "order": 3
            },
            "stopAll": true
        }
    ]
}